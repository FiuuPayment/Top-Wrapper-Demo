<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@color/colorSurfaceBase" />

    <!-- Top ambient wash: wide, very soft, no visible edge -->
    <item
        android:width="640dp"
        android:height="640dp"
        android:top="-140dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#2E44D62C"
                android:centerColor="#1544D62C"
                android:endColor="#0044D62C" />
        </shape>
    </item>

    <!-- Top ambient core: smaller, slightly richer, still fades well inside its own bounds -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:top="10dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#3D44D62C"
                android:centerColor="#1A44D62C"
                android:endColor="#0044D62C" />
        </shape>
    </item>

    <!-- Bottom ambient wash -->
    <item
        android:width="640dp"
        android:height="640dp"
        android:bottom="-140dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#2E44D62C"
                android:centerColor="#1544D62C"
                android:endColor="#0044D62C" />
        </shape>
    </item>

    <!-- Bottom ambient core -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="10dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#3D44D62C"
                android:centerColor="#1A44D62C"
                android:endColor="#0044D62C" />
        </shape>
    </item>

</layer-list>
