<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="TapCardDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <!-- Dimming is drawn explicitly by the scrim View in dialog_tap_card.xml, over the blurred snapshot. -->
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="VoidFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="VoidFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:padding">@dimen/spacing_sm</item>
        <item name="android:background">@drawable/bg_void_input</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="KeypadKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/keypad_key_min_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_keypad_key</item>
        <item name="android:elevation">2dp</item>
        <item name="android:fontFamily">@font/bebas</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
